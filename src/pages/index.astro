---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recentWriting = (await getCollection('blog', ({ data }) => data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const slugify = (id: string) => id.replace(/^en\//, '');
const formatDate = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title="Home">
  <!-- Intro -->
  <section class="max-w-2xl mx-auto px-6 sm:px-8 pt-28 pb-16">
    <h1
      class="font-serif text-ink mb-5"
      style="font-size: 3.25rem; font-weight: 500; line-height: 1.05; letter-spacing: -0.025em; font-variation-settings: 'opsz' 56;"
    >
      MingHsuan Lee
    </h1>
    <p class="text-muted text-sm font-mono mb-10 tracking-wide">AI ENGINEER &nbsp;·&nbsp; AUCKLAND, NZ</p>

    <div class="space-y-5 text-lg leading-relaxed text-text max-w-xl" style="font-size: 1.15rem; line-height: 1.65;">
      <p>
        I write about <em>AI agent infrastructure</em> &mdash; MCP, context engineering, retrieval, and orchestration at production scale.
      </p>
      <p>
        The notes here come from shipping multiple production AI agents on small, self-hosted infrastructure. The trade-offs, the decisions, the things worth knowing before you ship.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/writing" class="btn-primary no-underline">Read latest writing →</a>
      <a href="/contact#subscribe" class="btn-secondary no-underline">Subscribe</a>
    </div>
  </section>

  <!-- Latest writing -->
  <section class="max-w-2xl mx-auto px-6 sm:px-8 py-12">
    <div class="flex items-baseline justify-between mb-8 pb-3 border-b border-rule">
      <h2 class="text-xs font-mono text-muted uppercase tracking-[0.18em]" style="font-family: 'Inter', sans-serif;">Latest writing</h2>
      <a href="/writing" class="text-sm text-muted hover:text-ink no-underline">Archive →</a>
    </div>
    {recentWriting.length === 0 ? (
      <p class="text-muted text-sm py-6">Next post drops shortly.</p>
    ) : (
      <ul class="space-y-0">
        {recentWriting.map((post) => (
          <li class="entry">
            <a href={`/writing/${slugify(post.id)}`} class="block group no-underline hover:no-underline">
              <div class="flex items-baseline justify-between gap-6 mb-2">
                <h3
                  class="font-serif text-ink transition-colors"
                  style="font-size: 1.5rem; font-weight: 500; line-height: 1.25; font-variation-settings: 'opsz' 28;"
                >
                  {post.data.title}
                </h3>
                <time class="text-muted text-xs font-mono shrink-0 tracking-wide">
                  {formatDate(post.data.date)}
                </time>
              </div>
              {post.data.description && (
                <p class="text-muted leading-relaxed" style="font-size: 0.975rem;">{post.data.description}</p>
              )}
              {post.data.series && (
                <div class="mt-3">
                  <span class="tag-accent">{post.data.series}</span>
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- Ornament -->
  <div class="ornament" aria-hidden="true"></div>

  <!-- Subscribe band -->
  <section class="max-w-2xl mx-auto px-6 sm:px-8 py-8">
    <div class="border-y border-rule py-10">
      <div class="flex flex-col gap-4 text-center">
        <h3 class="font-serif text-ink" style="font-size: 1.75rem; font-weight: 500; font-variation-settings: 'opsz' 28;">Get new posts by email</h3>
        <p class="text-muted text-base max-w-md mx-auto leading-relaxed">
          One email per post. Long-form notes on AI agent infrastructure. No promotions.
        </p>
        <div class="mt-2">
          <a href="/contact#subscribe" class="btn-primary no-underline">Subscribe →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick links -->
  <section class="max-w-2xl mx-auto px-6 sm:px-8 py-16 grid sm:grid-cols-2 gap-x-12 gap-y-10">
    <div>
      <h3 class="text-xs font-mono text-muted uppercase tracking-[0.18em] mb-3">Now</h3>
      <p class="text-text leading-relaxed mb-3">
        Currently working on AI agent infrastructure and writing.
      </p>
      <a href="/now" class="text-sm">What I'm working on →</a>
    </div>
    <div>
      <h3 class="text-xs font-mono text-muted uppercase tracking-[0.18em] mb-3">About</h3>
      <p class="text-text leading-relaxed mb-3">
        Background, current role, and what I think about.
      </p>
      <a href="/about" class="text-sm">More about me →</a>
    </div>
  </section>
</BaseLayout>
