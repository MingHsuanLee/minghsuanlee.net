---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'MingHsuan Lee — writing about AI agent infrastructure at production scale.' } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Writing' },
  { href: '/now', label: 'Now' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site ?? "https://minghsuanlee.net").toString();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={`${title} | MingHsuan Lee`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MingHsuan Lee" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | MingHsuan Lee`} />
    <meta name="twitter:description" content={description} />
    <title>{title} | MingHsuan Lee</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500;6..72,600;6..72,700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FBSFZSE7XP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FBSFZSE7XP');
    </script>
  </head>
  <body class="bg-paper min-h-screen flex flex-col font-sans text-text">
    <!-- Nav (sticky on scroll) -->
    <nav class="sticky top-0 z-50 bg-paper/95 backdrop-blur-sm border-b border-rule">
      <div class="max-w-3xl mx-auto px-6 sm:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="font-serif text-ink no-underline hover:no-underline" style="font-weight: 600; font-size: 1.0625rem; font-variation-settings: 'opsz' 18; letter-spacing: -0.01em;">
            MingHsuan&nbsp;Lee
          </a>
          <div class="flex items-center gap-0.5 text-sm">
            {nav.filter(n => n.href !== '/').map(({ href, label }) => (
              <a
                href={href}
                class={`px-3 py-2 transition-colors hover:no-underline ${
                  pathname === href || (href !== '/' && pathname.startsWith(href))
                    ? 'text-ink font-semibold'
                    : 'text-muted hover:text-ink'
                }`}
              >
                {label}
              </a>
            ))}
            <span class="text-rule mx-2 hidden sm:inline">·</span>
            <a href="https://github.com/MingHsuanLee" target="_blank" rel="noopener noreferrer"
               class="px-3 py-2 text-muted hover:text-ink transition-colors text-sm hover:no-underline hidden sm:inline">
              GitHub <span class="text-xs">↗</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-32 pt-12 pb-12 border-t border-ruleLight">
      <div class="max-w-3xl mx-auto px-6 sm:px-8 text-sm text-muted">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <p class="font-serif" style="font-variation-settings: 'opsz' 16;">© {new Date().getFullYear()} MingHsuan Lee — Auckland, NZ</p>
          <div class="flex items-center gap-5">
            <a href="/contact#subscribe" class="text-muted hover:text-ink">Subscribe</a>
            <a href="https://github.com/MingHsuanLee" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/minghsuanlee/" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink">LinkedIn ↗</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
